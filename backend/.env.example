# Puerto del servidor
PORT=4000

# Conexión PostgreSQL
DATABASE_URL=postgres://jam:jam_password@localhost:5432/jam_db

# Secreto para firmar JWT (generar con: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))")
JWT_SECRET=cambiar_por_un_secreto_largo_y_aleatorio
JWT_EXPIRES_IN=7d

# Origen permitido para CORS (frontend)
CORS_ORIGIN=http://localhost:5173

# Entorno
NODE_ENV=development

# =============================================================
# Firebase Admin (para activación de premium desde Android)
# Obtener estas credenciales en:
# Firebase Console → Configuración del proyecto → Cuentas de servicio
# → Generar nueva clave privada (archivo JSON)
# Copiar aquí: project_id, client_email y private_key
# =============================================================
FIREBASE_PROJECT_ID=jam-64d1b
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxx@jam-64d1b.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n
