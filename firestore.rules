rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =============================================================
    // USUARIOS
    // Solo el propio usuario puede crear/modificar/borrar su documento.
    // Los campos sensibles (verificación y premium) están bloqueados
    // para escritura directa del cliente: solo la Cloud Function
    // "activarPremium" (Admin SDK) puede modificarlos.
    // =============================================================
    match /usuarios/{uid} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == uid
        && !request.resource.data.keys().hasAny([
          'esVerificado', 'esPremium', 'premiumHasta',
          'premiumVitalicio', 'apoyoBeta', 'puntosApoyo'
        ]);
      allow update: if request.auth != null && request.auth.uid == uid
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'esVerificado', 'esPremium', 'premiumHasta',
          'premiumVitalicio', 'apoyoBeta', 'puntosApoyo'
        ]);
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // =============================================================
    // JAMS
    // Cualquiera autenticado puede leer y crear.
    // Solo el creador puede modificar o eliminar su Jam.
    // =============================================================
    match /jams/{jamId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.creadoPor == request.auth.uid;
      allow update, delete: if request.auth != null
        && resource.data.creadoPor == request.auth.uid;

      // Chat de la Jam
      match /mensajes/{msgId} {
        allow read, write: if request.auth != null;
      }
    }

    // =============================================================
    // SOLICITUDES DE UNIÓN
    // =============================================================
    match /solicitudes/{docId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.usuarioId == request.auth.uid;
      allow update, delete: if request.auth != null;
    }

    // =============================================================
    // CONVERSACIONES 1-A-1
    // =============================================================
    match /conversaciones/{convId} {
      allow read, write: if request.auth != null;
      match /mensajes/{msgId} {
        allow read, write: if request.auth != null;
      }
    }

    // =============================================================
    // REPORTES (moderación de contenido)
    // =============================================================
    match /reportes/{docId} {
      allow create: if request.auth != null
        && request.resource.data.denuncianteId == request.auth.uid;
      allow read: if request.auth != null;
      allow update, delete: if false;
    }

    // =============================================================
    // NOTA: los campos de premium (esPremium, premiumVitalicio,
    // premiumHasta, apoyoBeta, puntosApoyo) solo los escribe la
    // Cloud Function "activarPremium" vía Admin SDK (ignora reglas).
    // Pendiente de producción: verificar purchaseToken en la función.
    // =============================================================
  }
}
