rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =============================================================
    // USUARIOS
    // - El usuario solo puede crear/editar SU propio documento.
    // - Los campos premium están BLOQUEADOS para el cliente.
    // - "jamsHistorial" se puede escribir de forma cruzada (el creador
    //   de una Jam lo actualiza en los participantes al eliminarla).
    // =============================================================
    match /usuarios/{uid} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == uid
        && !request.resource.data.keys().hasAny([
          'esVerificado', 'esPremium', 'premiumHasta',
          'premiumVitalicio', 'apoyoBeta', 'puntosApoyo'
        ]);
      allow update: if request.auth != null
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'esVerificado', 'esPremium', 'premiumHasta',
          'premiumVitalicio', 'apoyoBeta', 'puntosApoyo'
        ])
        && (
          request.auth.uid == uid
          || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['jamsHistorial'])
        );
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // =============================================================
    // RELACIONES (grafo social)
    // Cada doc es una arista seguidor -> seguido.
    // =============================================================
    match /relaciones/{docId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.seguidor == request.auth.uid;
      allow update: if false;
      allow delete: if request.auth != null
        && (resource.data.seguidor == request.auth.uid
            || resource.data.seguido == request.auth.uid);
    }

    // =============================================================
    // REPORTES (moderación)
    // =============================================================
    match /reportes/{docId} {
      allow create: if request.auth != null
        && request.resource.data.denuncianteId == request.auth.uid;
      allow read: if request.auth != null;
      allow update, delete: if false;
    }

    // =============================================================
    // RESTO (jams, chat, solicitudes, conversaciones)
    // Pendiente de endurecer con reglas granulares por colección.
    // =============================================================
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
