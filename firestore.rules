rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =============================================================
    // USUARIOS
    // - El usuario solo puede crear/editar SU propio documento.
    // - Los campos premium están BLOQUEADOS para el cliente (solo
    //   el backend Node con firebase-admin los escribe).
    // - "jamsHistorial" se escribe de forma cruzada (el creador de
    //   una Jam lo actualiza en los participantes al eliminarla).
    // =============================================================
    match /usuarios/{uid} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == uid
        && !request.resource.data.keys().hasAny([
          'esVerificado', 'esPremium', 'premiumHasta',
          'premiumVitalicio', 'apoyoBeta', 'puntosApoyo'
        ]);
      allow update: if request.auth != null
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'esVerificado', 'esPremium', 'premiumHasta',
          'premiumVitalicio', 'apoyoBeta', 'puntosApoyo'
        ])
        && (
          request.auth.uid == uid
          || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['jamsHistorial'])
        );
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // =============================================================
    // RELACIONES (grafo social)
    // =============================================================
    match /relaciones/{docId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.seguidor == request.auth.uid;
      allow update: if false;
      allow delete: if request.auth != null
        && (resource.data.seguidor == request.auth.uid
            || resource.data.seguido == request.auth.uid);
    }

    // =============================================================
    // JAMS
    // - Cualquiera autenticado puede leer (las privadas se filtran
    //   en el cliente).
    // - Solo el creador crea/actualiza/elimina.
    // - Excepción: un asistente puede salirse (quitarse de "asistentes").
    // =============================================================
    match /jams/{jamId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.creadoPor == request.auth.uid;
      allow update: if request.auth != null && (
        request.auth.uid == resource.data.creadoPor
        || (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['asistentes'])
          && request.auth.uid in resource.data.asistentes
        )
      );
      allow delete: if request.auth != null
        && request.auth.uid == resource.data.creadoPor;

      // Chat de la Jam: solo participantes (asistentes o creador)
      match /mensajes/{msgId} {
        allow read, write: if request.auth != null && (
          request.auth.uid == get(/databases/$(database)/documents/jams/$(jamId)).data.creadoPor
          || request.auth.uid in get(/databases/$(database)/documents/jams/$(jamId)).data.asistentes
        );
      }
    }

    // =============================================================
    // SOLICITUDES DE UNIÓN
    // - El solicitante crea y puede cancelar la suya.
    // - El creador de la Jam puede responder (borrar la solicitud).
    // =============================================================
    match /solicitudes/{docId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.usuarioId == request.auth.uid;
      allow update: if false;
      allow delete: if request.auth != null && (
        resource.data.usuarioId == request.auth.uid
        || request.auth.uid == get(/databases/$(database)/documents/jams/$(resource.data.jamId)).data.creadoPor
      );
    }

    // =============================================================
    // CONVERSACIONES 1-A-1
    // =============================================================
    match /conversaciones/{convId} {
      allow read: if request.auth != null
        && request.auth.uid in resource.data.participantes;
      allow create: if request.auth != null
        && request.auth.uid in request.resource.data.participantes;
      allow update, delete: if request.auth != null
        && request.auth.uid in resource.data.participantes;

      match /mensajes/{msgId} {
        allow read, write: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/conversaciones/$(convId)).data.participantes;
      }
    }

    // =============================================================
    // REPORTES (moderación)
    // =============================================================
    match /reportes/{docId} {
      allow create: if request.auth != null
        && request.resource.data.denuncianteId == request.auth.uid;
      allow read: if request.auth != null;
      allow update, delete: if false;
    }

    // =============================================================
    // RESTO (etiquetas/tags y colecciones auxiliares)
    // =============================================================
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
