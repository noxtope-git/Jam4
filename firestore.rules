rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =============================================================
    // RELACIONES (grafo social)
    // Cada doc es una arista seguidor -> seguido.
    // Solo puedo crear relaciones donde YO soy el seguidor.
    // Solo puedo borrar relaciones en las que participo.
    // =============================================================
    match /relaciones/{docId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.seguidor == request.auth.uid;
      allow update: if false;
      allow delete: if request.auth != null
        && (resource.data.seguidor == request.auth.uid
            || resource.data.seguido == request.auth.uid);
    }

    // =============================================================
    // REPORTES (moderación)
    // =============================================================
    match /reportes/{docId} {
      allow create: if request.auth != null
        && request.resource.data.denuncianteId == request.auth.uid;
      allow read: if request.auth != null;
      allow update, delete: if false;
    }

    // =============================================================
    // RESTO (pendiente de endurecer)
    //
    // "usuarios" aún no se bloquea a solo-propio-documento porque
    // "jamsHistorial" se escribe de forma cruzada (el creador de una
    // Jam actualiza el historial de todos los participantes al
    // eliminarla/terminarla). Para cerrarlo hay que mover
    // jamsHistorial a una subcolección o al backend Node.
    //
    // Los campos de premium (esPremium, apoyoBeta, puntosApoyo, etc.)
    // siguen escribibles por el cliente hasta desplegar la Cloud
    // Function "activarPremium" (requiere plan Blaze) o mover la
    // activación al backend Node.
    // =============================================================
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
